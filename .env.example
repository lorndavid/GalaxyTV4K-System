# Environment Configuration for HR & Attendance Management System

# Backend Server Configuration
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
ADMIN_URL=http://localhost:5173
WEB_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_attendance_db?schema=public"

# Security & Authentication
JWT_SECRET="super-secret-jwt-signing-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_MINUTES=15

# Default Company / Geo Settings (Overrides stored in DB CompanySettings table)
DEFAULT_TIMEZONE="Asia/Phnom_Penh"
DEFAULT_LATITUDE=11.5564
DEFAULT_LONGITUDE=104.9282
DEFAULT_ALLOWED_RADIUS_METERS=100
DEFAULT_GPS_ACCURACY_THRESHOLD_METERS=50
DEFAULT_QR_EXPIRATION_SECONDS=60
