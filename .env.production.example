# =================================================================
# Galaxy TV4K - Production Environment Variables
# =================================================================

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CreateAStrongRandomPassword2026!
POSTGRES_DB=hr_attendance_db

# Security & Authentication (Generate using: openssl rand -base64 48)
JWT_SECRET=replace_with_a_secure_random_64_character_string_here_e7a9b8c2
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=https://galaxytv.online,https://www.galaxytv.online,https://admin.galaxytv.online,https://api.galaxytv.online

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Server Ports (Internal to localhost)
PORT=4000
NODE_ENV=production
